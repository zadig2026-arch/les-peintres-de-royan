# Newsletter — Brevo (https://app.brevo.com)
#
# 1. Créer un compte Brevo (gratuit), puis dans Contacts > Listes, créer une
#    liste (ex. "Newsletter publique") et noter son ID numérique.
# 2. Récupérer une clé API : Paramètres > SMTP & API > Clés API.
# 3. (Recommandé) Activer le double opt-in : créer un modèle d'email de
#    confirmation dans Campagnes > Modèles, noter son ID, le mettre dans
#    BREVO_DOI_TEMPLATE_ID. Sans ce template, l'inscription est en simple opt-in.
#
# Ces variables sont à renseigner dans Vercel (Project > Settings > Environment
# Variables) pour Production + Preview, puis redéployer.

BREVO_API_KEY=
BREVO_LIST_ID=

# Optionnel — double opt-in (RGPD)
BREVO_DOI_TEMPLATE_ID=
BREVO_DOI_REDIRECT_URL=https://lespeintresderoyan.fr/?newsletter=confirmee

# Compteur de visites — Sanity (https://www.sanity.io)
#
# Le compteur est stocké dans un petit projet Sanity dédié (un unique document
# `visitCounter` avec un champ `total`), incrémenté côté serveur par la route
# /api/visites. Même approche que les sites GPPR et Bernard Devisme.
#
# Le projectId et le dataset sont publics (préfixe NEXT_PUBLIC_). Le write token
# est un SECRET : à renseigner dans Vercel (Production) et dans .env.local en
# local, jamais commité. On le génère sur https://www.sanity.io/manage
# (projet > API > Tokens, droits Editor).
#
# Sans le write token, la route /api/visites répond 503 et le compteur reste
# simplement masqué dans le pied de page (aucune erreur visible).

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=

# Optionnel — version de l'API Sanity (défaut : 2026-01-01)
NEXT_PUBLIC_SANITY_API_VERSION=

# Optionnel — base de départ ajoutée au total affiché. Le site existe déjà, donc
# pour ne pas repartir de 0 on peut afficher « base + visites réelles ».
# Ex. 5000. Laisser vide = démarrage à 0.
VISITES_OFFSET=
